# Copy to Railway Variables (or set via `railway variables`).
# Do not commit real secrets. Prefer linking a Railway Postgres service
# so DATABASE_URL is injected automatically.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=.railway.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Prefer DATABASE_URL from a linked Postgres service.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Or discrete vars (public proxy / local):
# DB_HOST=
# DB_NAME=railway
# DB_USER=postgres
# DB_PASSWORD=
# DB_PORT=
