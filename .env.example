# Railway / production variables. Prefer linking Postgres so DATABASE_URL
# is injected automatically. Never commit real secrets.

DJANGO_SECRET_KEY=  # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=.railway.app
# Must include the scheme. Wildcards need https:// too:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.up.railway.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Linked Railway Postgres (preferred):
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Or discrete vars for local / public proxy:
# DB_HOST=
# DB_NAME=railway
# DB_USER=postgres
# DB_PASSWORD=
# DB_PORT=
